{
  "expo": {
    "name": "Rustle",
    "slug": "rustle",
    "scheme": "rustle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.rustle",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.rustle"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.rustle",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F6F1E7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1C1A17"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21619f5a-d42f-4e57-a1b2-3795a6ae0b45"
      }
    },
    "owner": "rustleapp",
    "updates": {
      "url": "https://u.expo.dev/21619f5a-d42f-4e57-a1b2-3795a6ae0b45"
    }
  }
}
