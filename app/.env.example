# Copy to .env.local (git-ignored) and fill in from the rustle-dev Supabase project.
# Only the public anon key belongs here; never a service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Observability (public keys; empty means the SDK is off). PostHog uses the EU cloud.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
